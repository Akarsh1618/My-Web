<!DOCTYPE html>
<html>

<head>

    <title>Fortuner - Drive Beyond</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            color: #222;
        }


        nav {
            position: sticky;
            top: 0;
            z-index: 1000;

            background-color: black;
            padding: 18px 40px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            transition: 0.3s;
        }

        nav a:hover {
            color: orange;
        }


        .hero {
            position: relative;

            height: 600px;

            background-color: #222;

            overflow: hidden;
        }


        /* Hero image */

        .hero img {
            width: 100%;
            height: 100%;

            object-fit: cover;
        }


        .hero-content {
            position: absolute;

            top: 120px;
            left: 70px;

            color: white;

            width: 450px;
        }

        .hero-content h1 {
            font-size: 55px;
            margin: 0;
        }

        .hero-content p {
            font-size: 20px;
            line-height: 1.6;
        }


        .price {
            position: absolute;

            right: 50px;
            bottom: 50px;

            background-color: orange;

            padding: 15px 25px;

            border-radius: 10px;

            font-weight: bold;

            font-size: 20px;
        }


        .features {
            padding: 60px 40px;

            text-align: center;
        }

        .features h2 {
            font-size: 35px;
        }


        .feature-container {
            display: flex;

            justify-content: center;

            gap: 25px;

            margin-top: 30px;
        }


        .feature-card {
            position: relative;

            background-color: white;

            width: 250px;

            padding: 30px;

            border-radius: 12px;

            box-shadow: 0 5px 15px gray;

            transition: 0.3s;
        }

        .feature-card:hover {
            transform: translateY(-10px);
        }


        /* Small badge inside card */

        .badge {
            position: absolute;

            top: 10px;
            right: 10px;

            background-color: red;

            color: white;

            padding: 5px 8px;

            border-radius: 5px;

            font-size: 12px;
        }


        .about {
            background-color: white;

            padding: 60px 40px;

            text-align: center;
        }

        .about p {
            max-width: 700px;

            margin: auto;

            line-height: 1.8;

            font-size: 18px;
        }


        .contact {
            position: fixed;

            right: 25px;
            bottom: 25px;

            background-color: green;

            color: white;

            padding: 15px 20px;

            border-radius: 50px;

            text-decoration: none;

            box-shadow: 0 4px 10px gray;

            z-index: 2000;

            transition: 0.3s;
        }

        .contact:hover {
            background-color: darkgreen;

            transform: scale(1.1);
        }


        footer {
            background-color: black;

            color: white;

            text-align: center;

            padding: 30px;
        }

    </style>

</head>


<body>

    <nav>

        <div class="logo">
            TOYOTA
        </div>

        <div>

            <a href="#home">Home</a>

            <a href="#features">Features</a>

            <a href="#about">About</a>

        </div>

    </nav>


    <section class="hero" id="home">

        <img src="fortuner.jpg" alt="Toyota Fortuner">

        <div class="hero-content">

            <h1>FORTUNER</h1>

            <p>
                Built for adventure.
                Designed for those who go beyond.
            </p>

        </div>


        <!-- Absolute positioned badge -->

        <div class="price">

            Starting ₹33 Lakh

        </div>

    </section>


    <section class="features" id="features">

        <h2>Powerful Features</h2>


        <div class="feature-container">


            <div class="feature-card">

                <div class="badge">
                    POWER
                </div>

                <h3>Powerful Engine</h3>

                <p>
                    Strong performance for every journey.
                </p>

            </div>


            <div class="feature-card">

                <div class="badge">
                    SAFE
                </div>

                <h3>Advanced Safety</h3>

                <p>
                    Designed with advanced safety technology.
                </p>

            </div>


            <div class="feature-card">

                <div class="badge">
                    4X4
                </div>

                <h3>4WD Capability</h3>

                <p>
                    Ready for challenging roads and adventures.
                </p>

            </div>


        </div>

    </section>

    <section class="about" id="about">

        <h2>Go Beyond Limits</h2>

        <p>

            Toyota Fortuner combines bold design,
            powerful performance and advanced technology
            to create an SUV built for adventure.

            Whether you are travelling through the city
            or exploring the outdoors, Fortuner is ready.

        </p>

    </section>

    <footer>

        <p>
            © 2026 Toyota Fortuner Practice Website
        </p>

    </footer>



    <a href="#" class="contact">
        Contact Us
    </a>


</body>

</html>
